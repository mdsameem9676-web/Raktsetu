# Raktsetu Production Environment Variables Template
# Copy this file to .env.local or configure in your deployment dashboard (e.g. Vercel, Netlify)

# Supabase Cloud Database Configuration (Get from Supabase Dashboard -> Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Application Information
VITE_APP_TITLE=Raktsetu
VITE_APP_DESCRIPTION=Intelligent Blood Donation & Emergency Coordination Platform

# Geocoding / Location Services (Optional: defaults to OpenStreetMap Nominatim public API)
# VITE_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Build Mode (development | production)
NODE_ENV=production
